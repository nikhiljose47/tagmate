# Supabase & Map Keys
MAPTILER_API_KEY=your-maptiler-api-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Business integrations — OAuth token encryption (see functions/api/business/_crypto.js).
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Instagram API with Instagram Login (Step 2) — from Meta Developer Dashboard,
# your app's "Instagram" product → API setup with Instagram Login.
# See docs/INSTAGRAM_INTEGRATION_SETUP.md for exact steps.
INSTAGRAM_APP_ID=your-instagram-app-id-here
INSTAGRAM_APP_SECRET=your-instagram-app-secret-here
INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/integrations/instagram/callback
META_GRAPH_API_VERSION=v21.0

# WhatsApp Business Platform — Cloud API + Embedded Signup (Step 3).
# See docs/WHATSAPP_INTEGRATION_SETUP.md for exact Meta Dashboard steps.
# Reuses META_GRAPH_API_VERSION above — do not duplicate it with a separate version pin.
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here
META_BUSINESS_ID=your-meta-business-portfolio-id-here
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-string-and-set-it-in-meta-too

# E2E Test Credentials
# You can customize these if you want to run tests against your own seeded users.

# Default password fallback if individual passwords are not set
E2E_TEST_PASSWORD=replace-with-test-password

E2E_USER1_EMAIL=e2e-user-1@example.invalid
E2E_USER1_PASSWORD=replace-with-test-password
E2E_USER1_NAME=UserOne

E2E_USER2_EMAIL=e2e-user-2@example.invalid
E2E_USER2_PASSWORD=replace-with-test-password
E2E_USER2_NAME=UserTwo

E2E_USER3_EMAIL=e2e-user-3@example.invalid
E2E_USER3_PASSWORD=replace-with-test-password
E2E_USER3_NAME=UserThree

E2E_USER4_EMAIL=e2e-user-4@example.invalid
E2E_USER4_PASSWORD=replace-with-test-password
E2E_USER4_NAME=UserFour

E2E_USER5_EMAIL=e2e-user-5@example.invalid
E2E_USER5_PASSWORD=replace-with-test-password
E2E_USER5_NAME=UserFive
